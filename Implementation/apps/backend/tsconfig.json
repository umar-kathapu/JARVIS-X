{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "composite": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@jarvis-x/types": ["../../packages/types/dist/index.d.ts"],
      "@jarvis-x/shared": ["../../packages/shared/dist/index.d.ts"],
      "@jarvis-x/utils": ["../../packages/utils/dist/index.d.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*"]
}






