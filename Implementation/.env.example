# Environment Configuration Template for JARVIS-X

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Infrastructure Connection (PostgreSQL & Redis)
DATABASE_URL=postgresql://jarvis_admin:jarvis_secure_pass_2026@localhost:5432/jarvis_x_db?schema=public
REDIS_URL=redis://localhost:6379

# Security & Authentication (Mandatory: Must be >= 32 characters long)
JWT_SECRET=replace_with_a_unique_secure_random_string_at_least_32_chars_long
JWT_REFRESH_SECRET=replace_with_a_different_unique_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Desktop Client Config
ELECTRON_ENABLE_LOGGING=true
ELECTRON_REMOTE_DEBUGGING_PORT=9222

# AI Models & External Providers
OPENAI_API_KEY=sk-proj-example-key-here
ANTHROPIC_API_KEY=sk-ant-example-key-here
OLLAMA_BASE_URL=http://localhost:11434
